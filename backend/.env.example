# Server
HOST=0.0.0.0
PORT=8000
# 5173 is the Vite dev server; 3000 is the host port docker-compose maps it to
# (the 5141-5240 range is reserved by Hyper-V on Windows).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite first, per plan/prototype-plan.md section 3)
DATABASE_URL=sqlite:///./data/app.db

# Local artifact storage
DATA_DIR=./data

# Check concurrency (see plan/prototype-plan.md section 4)
MAX_CONCURRENT_CHECKS=2
PER_DOMAIN_CONCURRENCY=1
PAGE_TIMEOUT_SECONDS=25
# Overall per-check budget (launch + navigation + screenshot + diff)
# Must exceed PAGE_TIMEOUT_SECONDS.
CHECK_TIMEOUT_SECONDS=90
REDIRECT_LIMIT=5
MAX_ARTIFACT_SIZE_MB=10

# Change-detection thresholds. A check is flagged Changed only when a diff score
# is strictly greater than its threshold; smaller diffs are treated as OK.
TEXT_CHANGE_THRESHOLD=0.02
VISUAL_CHANGE_THRESHOLD=0.01

# SSRF guard (see plan/prototype-plan.md section 10)
ALLOWED_SCHEMES=http,https
